<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="views_time_cache">
  <description>PHP CodeSniffer configuration for Views Time Cache.</description>
  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
  <arg name="extensions" value="php,module,inc,install,test,profile,theme,info,txt,md,yml"/>
  <file>.</file>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <!-- Markdown files do not need line-length enforcement. -->
  <rule ref="Generic.Files.LineLength">
    <exclude-pattern>*.md</exclude-pattern>
    <!-- Hard error at 150 chars; drupal.org CI uses this threshold. -->
    <properties>
      <property name="lineLimit" value="80"/>
      <property name="absoluteLineLimit" value="150"/>
    </properties>
  </rule>
</ruleset>
